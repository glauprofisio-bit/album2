{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate-avatar.js": {
      "maxDuration": 60
    },
    "api/load-data/index.js": {
      "maxDuration": 10
    },
    "api/save-data/index.js": {
      "maxDuration": 10
    }
  }
}
